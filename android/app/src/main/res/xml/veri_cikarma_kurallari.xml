<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 ve sonrası için yedekleme / cihaz aktarımı kuralları.
  Kullanıcının hesap geçmişi ve ayarları taşınır; önbellek taşınmaz.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_webview/" />
        <exclude domain="file" path="app_webview/Default/Cache/" />
        <exclude domain="file" path="app_webview/Default/Code Cache/" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="app_webview/" />
        <exclude domain="file" path="app_webview/Default/Cache/" />
        <exclude domain="file" path="app_webview/Default/Code Cache/" />
    </device-transfer>
</data-extraction-rules>
